# Environment-specific values, auto-loaded by Terraform from the module dir.
# Copy to `secret.auto.tfvars` (gitignored) and fill in. This file includes the
# dashboard app-registration secret and must never be committed.

subscription_id               = "00000000-0000-0000-0000-000000000000" # your Dev/Test subscription
postgres_admin_object_id      = "00000000-0000-0000-0000-000000000000" # deployer Entra objectId
postgres_admin_principal_name = "you@example.com"                      # deployer UPN

# Dashboard Easy Auth. Create a single-tenant Entra app registration and secret,
# deploy once, then add `terraform output -raw dashboard_auth_callback_url` as a
# Web redirect URI. Configure the registration to emit security-group claims,
# and put the operator group's object ID here too.
dashboard_auth_client_id       = "00000000-0000-0000-0000-000000000000"
dashboard_auth_client_secret   = "replace-with-app-registration-secret"
dashboard_operator_group_id    = "00000000-0000-0000-0000-000000000000"
