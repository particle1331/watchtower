{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode-go/gpt-6-luna",
  "subagent_depth": 1,
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "opencode-go", "effect": "allow" }
    ]
  },
  "agent": {
    "explore": {
      "disable": false
    }
  }
}
