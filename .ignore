# Read by ripgrep (used by opencode's grep/glob). The knowledge base is the
# .ipynb source files under nb/notes/, nb/articles/, and nb/courses/.
# Legacy .ipynb files are excluded from retrieval.
*.ipynb
*.pdf
*.html
.ipynb_checkpoints/
_site/
nb/notes/pdf/
nb/articles/pdf/
.watchtower/
.venv/
# BEGIN oh-my-opencode-slim worktrees
!.slim/
!.slim/worktrees.json
!.slim/worktrees/
!.slim/worktrees/**
# END oh-my-opencode-slim worktrees
